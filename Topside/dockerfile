# =================================================================
# STAGE 1: The C++ Warehouse (Ubuntu 18.04 + Boost 1.65.1 + OpenMVS)
# =================================================================
FROM --platform=linux/amd64 openmvs/openmvs-ubuntu:latest AS openmvs_source

# =================================================================
# STAGE 2: The AI Modern Environment (Ubuntu 22.04 + Python 3.10)
# =================================================================
FROM --platform=linux/amd64 ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# 1. Install modern Python 3.10, COLMAP, and UI graphics tools
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    colmap \
    libgl1-mesa-glx \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# 2. SURGICAL EXTRACTION: Copy tools and isolated library frameworks
COPY --from=openmvs_source /usr/local/bin/OpenMVS /usr/local/bin/OpenMVS
COPY --from=openmvs_source /usr/local/lib /usr/local/lib/openmvs_libs

# Legacy Boost 1.65.1 Links
COPY --from=openmvs_source /usr/lib/x86_64-linux-gnu/libboost_program_options.so* /usr/local/lib/openmvs_libs/
COPY --from=openmvs_source /usr/lib/x86_64-linux-gnu/libboost_serialization.so* /usr/local/lib/openmvs_libs/
COPY --from=openmvs_source /usr/lib/x86_64-linux-gnu/libboost_filesystem.so* /usr/local/lib/openmvs_libs/
COPY --from=openmvs_source /usr/lib/x86_64-linux-gnu/libboost_system.so* /usr/local/lib/openmvs_libs/
COPY --from=openmvs_source /usr/lib/x86_64-linux-gnu/libboost_iostreams.so* /usr/local/lib/openmvs_libs/

# 🔥 THE FIX: Surgically pull legacy OpenCV C++ shared objects and symlinks
COPY --from=openmvs_source /usr/lib/x86_64-linux-gnu/libopencv_core.so* /usr/local/lib/openmvs_libs/
COPY --from=openmvs_source /usr/lib/x86_64-linux-gnu/libopencv_imgcodecs.so* /usr/local/lib/openmvs_libs/
COPY --from=openmvs_source /usr/lib/x86_64-linux-gnu/libopencv_imgproc.so* /usr/local/lib/openmvs_libs/
COPY --from=openmvs_source /usr/lib/x86_64-linux-gnu/libopencv_highgui.so* /usr/local/lib/openmvs_libs/
COPY --from=openmvs_source /usr/lib/x86_64-linux-gnu/libopencv_videoio.so* /usr/local/lib/openmvs_libs/

# 3. Create System Map pointers
ENV PATH="/usr/local/bin/OpenMVS:${PATH}"
ENV LD_LIBRARY_PATH="/usr/local/lib/openmvs_libs:${LD_LIBRARY_PATH}"

RUN pip3 install --no-cache-dir --upgrade pip setuptools wheel

RUN pip3 install --no-cache-dir opencv-python numpy ultralytics

WORKDIR /workspace
COPY . /workspace

CMD ["python3", "test_cameras.py"]